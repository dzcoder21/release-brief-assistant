# --- Server ---
PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/release-brief-assistant
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
# Comma-separated list of allowed browser origins
CLIENT_URL=http://localhost:5173

# --- AI provider (never expose these in the frontend) ---
# AI_PROVIDER: "openai" (any OpenAI-compatible chat completions API) or "anthropic"
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=
# Optional. Examples:
#   OpenAI (default):  https://api.openai.com/v1
#   Gemini (OpenAI-compatible): https://generativelanguage.googleapis.com/v1beta/openai
#   Groq:              https://api.groq.com/openai/v1
#   Ollama (local):    http://localhost:11434/v1
#   Anthropic:         https://api.anthropic.com
AI_BASE_URL=
AI_TIMEOUT_MS=120000
# Optional output token cap (required by Anthropic; defaults to 8000 there)
AI_MAX_TOKENS=
